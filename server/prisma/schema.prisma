generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  EQUIPO
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  nombre    String
  rol       Rol     @default(EQUIPO)
  esKarla   Boolean @default(false)
  activo    Boolean @default(true)
  avatarUrl String?
  // Área a la que pertenece (web | diseno_grafico | redes_sociales) — determina
  // qué proyectos ve por defecto en el dashboard. null = ve todos (sin filtrar).
  area      String?
  // Lista plana de etiquetas libres (ej. "copy", "wordpress", "elementor") —
  // transparencia de quién puede hacer qué, sin niveles ni jerarquía.
  habilidades String[] @default([])

  apiKeys ApiKey[]

  creadoEn DateTime @default(now())

  @@map("users")
}

// API key personal para conectar por MCP/CLI (Claude Code) a nombre propio,
// en vez de la MCP_API_KEY compartida. Se genera desde el portal, se muestra
// completa una sola vez y de ahí en adelante solo se ve `prefijo` — perderla
// significa revocarla y generar otra, no hay forma de recuperarla.
model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Etiqueta libre para reconocerla en la lista (ej. "laptop trabajo"). Opcional.
  nombre String @default("")
  // Primeros caracteres del token, visibles en la UI para identificarla sin
  // volver a mostrarla completa.
  prefijo String
  // sha256 hex del token completo — el token en claro nunca se guarda.
  hash    String @unique

  ultimoUso  DateTime?
  creadaEn   DateTime  @default(now())
  revocadaEn DateTime?

  @@map("api_keys")
}

model Proyecto {
  id     String @id @default(cuid())
  slug   String @unique
  status String @default("pendiente_anticipo")
  tipo   String @default("finito")

  // `cliente` (Json libre) sigue siendo la fuente de verdad hoy — no se toca
  // en esta migración. `clienteId` es aditivo y opcional: se llena a mano,
  // proyecto por proyecto, después de revisar la propuesta de agrupación
  // (server/src/scripts/proponerAgrupacionClientes.js). Nunca a ciegas.
  cliente             Json
  clienteId           String?
  clienteRef          Cliente?  @relation(fields: [clienteId], references: [id])
  proyecto            Json
  condicionesTecnicas Json
  equipo              Json
  linksCliente        Json     @default("{}")
  driveRespuestasId   String?
  vistoAdminEn        DateTime?
  tiempos             Json     @default("{}")
  passwordCliente     String
  // Una o varias áreas (web | diseno_grafico | redes_sociales) — un proyecto
  // integral tiene varias. Vacío = visible en cualquier filtro de área.
  areas               String[] @default([])

  tareas      Tarea[]
  log         LogEntry[]
  solicitudes Solicitud[]

  creadoEn DateTime @default(now())

  @@map("proyectos")
}

// Cliente real (persona/negocio), independiente de cuántos Proyecto tenga.
// Nace vacía — se llena revisando la propuesta de agrupación de
// proponerAgrupacionClientes.js, nunca por migración automática (con 14
// proyectos hoy, revisar a mano toma una tarde; agrupar mal uniría a dos
// clientes distintos bajo el mismo registro, sin forma fácil de deshacerlo
// después de que ambos ya operen sobre él).
model Cliente {
  id              String  @id @default(cuid())
  crmId           String? @unique
  nombreComercial String
  contactoNombre  String?
  correo          String?
  whatsapp        String?
  // Copiado de la referencia informativa del primer Proyecto que se le
  // vincule — no se recalcula solo; si cambia, se edita a mano.
  participantes   Json    @default("[]")

  proyectos   Proyecto[]
  sitios      Sitio[]
  solicitudes Solicitud[]
  incidencias Incidencia[]

  creadoEn DateTime @default(now())

  @@map("clientes")
}

// Qué existe HOY en un sitio de un cliente — distinto de
// Proyecto.condicionesTecnicas, que son banderas de qué había que HACER,
// congeladas al crear el proyecto que lo construyó. Un cliente puede tener
// varios (sitio principal, tienda). Vive colgado de Cliente, no de un
// Proyecto puntual, porque un sitio sobrevive al proyecto que lo creó —
// existe mientras dure el mantenimiento, aunque el proyecto ya se haya
// cerrado hace tiempo.
//
// A propósito NO guarda usuarios/contraseñas de WordPress ni del hosting —
// esas siguen su camino actual (Drive). Guardar credenciales aquí convierte
// a Foco en una bóveda, con todo lo que implica en cifrado/auditoría; si
// algún día se quiere resolver de verdad, el camino es un gestor de
// contraseñas del equipo con enlace desde aquí, no un campo de texto plano.
model Sitio {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Para distinguir cuando un cliente tiene más de uno (ej. "Sitio principal", "Tienda").
  nombre                 String
  dominio                String? @unique
  url                    String?
  hostingProveedor       String?
  dnsProveedor           String?
  tipoInstalacion        String? // WordPress | WooCommerce | otro — texto libre por ahora
  driveFolderUrl         String?
  contactoTecnico        String?
  coberturaMantenimiento String? // texto libre por ahora: incluido / adicional / sin contratar
  infraestructura        String  @default("sin_localizar")
  enhancedSiteId         String?
  enhancedServerId       String?
  cloudflareZoneId       String?

  incidencias Incidencia[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  solicitudes Solicitud[]

  @@map("sitios")
}

// Mesa interna de mantenimiento web. Una incidencia pertenece al cliente y al
// sitio afectados, no a un Proyecto: así una sola bandeja reúne todos los
// reportes sin crear un proyecto artificial por cliente.
model Incidencia {
  id       String @id @default(cuid())
  folio    Int    @unique @default(autoincrement())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  sitioId   String
  sitio     Sitio   @relation(fields: [sitioId], references: [id], onDelete: Restrict)

  titulo         String
  descripcion    String @default("")
  estado         String @default("todo") // todo | doing | revision | done
  prioridad      String @default("normal") // urgente | normal | cuando_se_pueda
  cobertura      String @default("por_valorar") // incluido | cortesia | adicional | por_valorar
  infraestructura String @default("sin_localizar") // esbrillante | externa | sin_localizar
  origen         String @default("interno") // whatsapp | telefono | interno | monitoreo
  tipo           String @default("falla") // falla | actualizacion | preventivo | consulta
  responsableId  String?
  reportadoPor   String?
  telefonoOrigen String?
  fechaLimite    DateTime?

  diagnostico String @default("")
  resolucion  String @default("")
  causaRaiz   String @default("")
  archivada   Boolean @default(false)

  iniciadoEn  DateTime?
  resueltoEn  DateTime?
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([estado, prioridad, creadoEn])
  @@index([clienteId])
  @@index([sitioId])
  @@map("incidencias")
}

model Tarea {
  id         String   @id
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  fase             Int
  // Agrupador libre y opcional para proyectos integrales que combinan varios
  // objetivos sin fases compartidas (ej. "Video", "Sitio web", "Redes") — la
  // vista del proyecto agrupa por este campo cuando tiene valor, además de
  // por fase. Cambio deliberadamente mínimo: sin tabla propia ni jerarquía.
  frente           String?
  orden            Float    @default(0)
  titulo           String
  responsable      String   @default("equipo")
  dependencias     String[]
  condicion        String?
  descripcion      String   @default("")
  queHacer         String   @default("")
  necesitasAntes   String   @default("")
  plantillaMensaje String   @default("")
  queEntregas      String   @default("")
  linkTipo         String?

  // Prioridad y fecha límite propias del equipo, independientes de
  // plazoHoras/disponibleDesde (que solo aplican a tareas esCliente y
  // gatillan recordatorios). Cualquier tarea del equipo puede tener las
  // suyas — es lo que permite ordenar "Mis tareas" por lo urgente.
  prioridad   String? // 'urgente' | 'normal' | 'cuando_se_pueda'
  fechaLimite DateTime?

  esCliente            Boolean @default(false)
  instruccionesCliente String  @default("")
  plazoHoras           Int?
  esRutaCritica        Boolean @default(false)
  soloAdmin            Boolean @default(false)
  soloKarlaOAdmin      Boolean @default(false)
  opcional             Boolean @default(false)
  custom               Boolean @default(false)

  estado        String    @default("pendiente")
  completadaPor String?
  completadaEn  DateTime?
  asignadoA     String?

  creadoEn             DateTime  @default(now())
  disponibleDesde      DateTime?
  avisosDesactivados   Boolean   @default(false)
  ultimoRecordatorioEn DateTime?

  respuestaTexto       String?
  respuestaArchivoUrl  String?
  respuestaArchivoNombre String?
  driveFolderUrl       String?

  comentarios Comentario[]

  @@map("tareas")
}

model Comentario {
  id      String @id @default(cuid())
  tareaId String
  tarea   Tarea  @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  autor       String
  autorId     String
  texto       String
  mencionados String[] @default([])

  creadoEn DateTime @default(now())

  @@map("comentarios_tarea")
}

model Plantilla {
  id          String   @id @default(cuid())
  nombre      String
  area        String   @default("General")
  descripcion String   @default("")
  fases       Json     @default("[]")

  tareas TareaPlantilla[]

  creadoEn DateTime @default(now())

  @@map("plantillas")
}

model TareaPlantilla {
  id          String    @id @default(cuid())
  plantillaId String
  plantilla   Plantilla @relation(fields: [plantillaId], references: [id], onDelete: Cascade)

  fase             Int
  orden            Float    @default(0)
  titulo           String
  responsable      String   @default("equipo")
  dependencias     String[]
  condicion        String?
  descripcion      String   @default("")
  queHacer         String   @default("")
  necesitasAntes   String   @default("")
  plantillaMensaje String   @default("")
  queEntregas      String   @default("")
  linkTipo         String?

  esCliente             Boolean @default(false)
  instruccionesCliente  String  @default("")
  plazoHoras            Int?
  esRutaCritica         Boolean @default(false)
  soloAdmin             Boolean @default(false)
  soloKarlaOAdmin       Boolean @default(false)
  opcional              Boolean @default(false)

  @@map("tareas_plantilla")
}

model Solicitud {
  id         String   @id @default(cuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  titulo      String
  descripcion String

  estado        String    @default("pendiente") // pendiente | aprobada | rechazada
  motivoRechazo String?
  resueltaPor   String?
  resueltaEn    DateTime?
  tareaId       String? // referencia informativa a la Tarea creada al aprobar (sin FK, la tarea se puede eliminar)

  archivoUrl    String?
  archivoNombre String?

  // Trabajo suelto (4.3–4.5 de plan-foco.md): de dónde vino el ticket y de
  // qué se trata — no cambia el flujo de aprobación existente, solo lo
  // describe. 'portal' es el default porque hasta ahora era el único origen.
  tipo      String? // 'falla' | 'actualizacion' | 'preventivo' | 'consulta'
  cobertura String? // 'incluido' | 'adicional' | 'por_valorar'
  origen    String  @default("portal") // 'portal' | 'whatsapp' | 'telefono' | 'interno'

  // Mantenimiento cuelga del Sitio, diseño/otro trabajo suelto cuelga del
  // Cliente — además del proyecto (que sigue siendo el tablero/cola real).
  sitioId   String?
  sitio     Sitio?   @relation(fields: [sitioId], references: [id])
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  creadaEn DateTime @default(now())

  @@map("solicitudes")
}

// Clientes MCP registrados dinámicamente (RFC 7591) al conectar desde
// claude.ai u otro cliente OAuth. Se persiste para que el client_id
// siga siendo válido entre reinicios/deploys del servidor.
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String?
  redirectUris Json

  creadoEn DateTime @default(now())

  @@map("oauth_clients")
}

model LogEntry {
  id         String   @id @default(cuid())
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  fecha    DateTime @default(now())
  usuario  String
  accion   String
  detalle  String   @default("")

  @@map("log_entries")
}
