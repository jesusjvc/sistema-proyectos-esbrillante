DATABASE_URL="postgresql://usuario:password@localhost:5432/esbrillante"
JWT_SECRET="cambia-esto-por-una-clave-larga-y-segura"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Key compartida para autenticar el endpoint MCP (/mcp) usado por Claude Code
# desde otros repos. Generar con: openssl rand -hex 32
MCP_API_KEY="cambia-esto-por-una-clave-larga-y-segura"

# Flujo OAuth (/oauth/*) que le permite a claude.ai (u otro conector web)
# conectarse al MCP: pide este mismo MCP_API_KEY en una pantalla de login
# en vez de un Client ID/Secret. MCP_OAUTH_REDIRECT_HOSTS restringe a qué
# dominios se les acepta redirect_uri al registrar un cliente (protege
# contra que alguien registre un client_id apuntando a un dominio propio).
# Opcional — default: "claude.ai,claude.com". Localhost siempre se permite.
MCP_OAUTH_REDIRECT_HOSTS="claude.ai,claude.com"

# Subida de archivos de clientes a Google Drive vía Service Account.
# GOOGLE_SERVICE_ACCOUNT_KEY: contenido completo del JSON de la cuenta de
# servicio (como string de una sola línea, ej. usando `jq -c . key.json`).
# DRIVE_RESPUESTAS_ROOT_ID: ID de la carpeta de Drive compartida con el
# email de la cuenta de servicio (rol Editor) — está en la URL de la carpeta.
# Si no se configuran, la subida de archivos queda deshabilitada pero el
# resto del sistema sigue funcionando normal.
GOOGLE_SERVICE_ACCOUNT_KEY=''
DRIVE_RESPUESTAS_ROOT_ID=''

# Correos transaccionales vía Mailjet (aviso al admin cuando el cliente
# responde algo; más adelante también recordatorios automáticos).
# MAILJET_API_KEY / MAILJET_API_SECRET: desde tu cuenta de Mailjet
# (Account Settings → API Key Management).
# MAILJET_FROM_EMAIL: debe ser un remitente/dominio verificado en Mailjet.
# Si no se configuran, los correos simplemente no se envían — el resto
# del sistema (dashboard, badges) sigue funcionando igual.
MAILJET_API_KEY=''
MAILJET_API_SECRET=''
MAILJET_FROM_EMAIL='avisos@esbrillante.mx'
MAILJET_FROM_NAME='EsBrillante — Sistema de Proyectos'

# Integración con esbrillante-pages-mcp (prototipos.esbrillante.mx) para
# gestionar prototipos HTML desde el dashboard de proyectos. PAGES_MCP_API_KEY
# debe coincidir con la API_KEY configurada en ese servidor.
PAGES_MCP_URL="https://prototipos.esbrillante.mx"
PAGES_MCP_API_KEY="cambia-esto-por-una-clave-larga-y-segura"

# Dirección opuesta: esbrillante-pages-mcp llama aquí (POST
# /api/prototipos/:slug/notificar-revision) cuando un cliente termina de
# revisar un prototipo, para avisarle por correo a los Admin activos.
# Debe coincidir con SEGUIMIENTO_NOTIFY_KEY en ese servidor.
PROTOTIPOS_NOTIFY_KEY="cambia-esto-por-una-clave-larga-y-segura"
