# Buzón IMAP de soporte. Google Workspace: imap.gmail.com:993.
# El usuario debe ser un buzón DEDICADO a soporte (cuenta soporte@esbrillante.mx
# en Workspace) — no apuntar a un buzón de uso personal: el puente lee TODOS
# los no leídos de la bandeja que le des.
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER="soporte@esbrillante.mx"
# Contraseña de aplicación de la cuenta (no la normal): cuenta de Google →
# Seguridad → verificación en 2 pasos → Contraseñas de aplicación.
IMAP_PASS=""
# Bandeja a leer (default INBOX) y carpeta opcional a donde mover los ya
# procesados (se crea a mano en Gmail, ej. "Procesados"). Vacío = solo se
# marcan como leídos.
CORREO_BUZON="INBOX"
CORREO_MOVER_A=""

# Foco al donde se ingesta. FOCO_API_KEY es la CORREO_INGEST_KEY del server
# (no la MCP_API_KEY). En local: http://localhost:3001
FOCO_URL="https://api-proyectos.esbrillante.mx"
FOCO_API_KEY=""

# Cada cuánto revisa el buzón (minutos, mín. 1). Default 5.
INTERVALO_MINUTOS="5"
