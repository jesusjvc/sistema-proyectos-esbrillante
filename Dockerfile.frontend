FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=https://foco-api-lr.esbrillante.mx
ENV VITE_API_URL=$VITE_API_URL
# client id publico por diseno (el frontend lo expone en su bundle)
ARG VITE_GOOGLE_CLIENT_ID=82795136970-9f5abare0ig9fucbrdoo5ekrgsih88pb.apps.googleusercontent.com
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build
FROM nginxinc/nginx-unprivileged:alpine
COPY nginx-levelrail-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
