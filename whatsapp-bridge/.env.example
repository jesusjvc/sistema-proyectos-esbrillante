# ── Tu OpenWA (open-wa.org) ──
# La URL donde corre (dashboard/API) y una clave API (owa_k1_...)
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
# Nombre o id de la sesión de WhatsApp (opcional si solo hay una)
OPENWA_SESION=

# ── Foco (producción) ──
FOCO_URL=https://api-proyectos.esbrillante.mx
# La misma API key del MCP (Claude Code → ~/.claude.json → esbrillante-seguimiento)
FOCO_API_KEY=

# Cada cuántos minutos sincroniza (mínimo 5)
INTERVALO_MINUTOS=60
